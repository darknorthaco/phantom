{
  "_comment": "Phantom LLM Task Master Configuration — Governed by PHANTOM_DOCTRINE.md and PHANTOM_MANIFEST.md",
  "_governance": {
    "soul": "doctrine/PHANTOM_MANIFEST.md",
    "mind": "doctrine/PHANTOM_DOCTRINE.md",
    "body": ".cursorrules + PHANTOM_TEN_COMMANDMENTS.md"
  },

  "execution_mode": {
    "default": "auto",
    "allowed_modes": ["auto", "hybrid", "manual"],
    "env_override": "PHANTOM_EXECUTION_MODE",
    "allow_per_task_override": true
  },

  "model": {
    "default_model": "phi-3.5-mini",
    "default_quant": "Q4_K_M",
    "default_format": "GGUF",
    "model_type": "rule_based_with_learning",
    "model_path": null,
    "model_size": "small",
    "context_length": 1024,
    "precision": "fp16",
    "batch_size": 1
  },

  "resource_limits": {
    "max_memory_mb": 2048,
    "max_vram_mb": 2048,
    "target_gpu": "auto",
    "target_vram_gb": 4
  },

  "routing": {
    "fallback_to_smart_programming": true,
    "max_decision_history": 100,
    "confidence_threshold": 0.5,
    "enable_learning": true
  },

  "hybrid_mode": {
    "proposal_timeout_seconds": 300,
    "require_approval_reason": false,
    "auto_expire_proposals": true,
    "batch_approval_enabled": true,
    "proposal_notify_via_socket": true
  },

  "human_priority": {
    "enabled": true,
    "check_interval_seconds": 5,
    "cpu_threshold_percent": 70,
    "gpu_threshold_percent": 60,
    "vram_threshold_percent": 70,
    "auto_mode_action": "withdraw",
    "hybrid_mode_action": "pause",
    "manual_mode_action": "unaffected",
    "monitored_processes": [
      "game", "steam", "epic", "blender", "davinci",
      "premiere", "photoshop", "obs", "unity", "unreal"
    ]
  },

  "socket": {
    "default_host": "localhost",
    "default_port": 8081,
    "reconnect_attempts": 3,
    "reconnect_delay_seconds": 5
  },

  "gpu_profiles": {
    "_comment": "Auto-populated during installation when Phantom scans the network for workers. Do not hardcode GPU model names here — the installer discovers hardware and writes this section. Example entry format shown below.",
    "_example": {
      "performance_tier": "flagship|mainstream|legacy|professional",
      "memory_gb": 0,
      "tensor_cores": "none|3rd_gen|4th_gen",
      "best_for": ["inference", "training", "data_processing"],
      "score_multiplier": 1.0
    }
  },

  "task_preferences": {
    "ml_inference": {
      "preferred_features": ["tensor_cores", "high_memory"],
      "avoid_features": [],
      "memory_requirement": "medium"
    },
    "training": {
      "preferred_features": ["tensor_cores", "high_memory"],
      "avoid_features": [],
      "memory_requirement": "high"
    },
    "large_model_inference": {
      "preferred_features": ["tensor_cores", "high_memory"],
      "avoid_features": [],
      "memory_requirement": "very_high"
    },
    "data_processing": {
      "preferred_features": ["high_memory"],
      "avoid_features": [],
      "memory_requirement": "high"
    },
    "image_processing": {
      "preferred_features": ["tensor_cores"],
      "avoid_features": [],
      "memory_requirement": "low"
    },
    "stable_inference": {
      "preferred_features": ["proven_stability"],
      "avoid_features": [],
      "memory_requirement": "low"
    }
  }
}
