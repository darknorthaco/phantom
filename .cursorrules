# PHANTOM .cursorrules
# Body of the Phantom Intelligence Fabric
# Operational Constraints for Development
#
# Governance Layer: BODY
# This file (together with PHANTOM_TEN_COMMANDMENTS.md) enforces the
# Doctrine in action. The Body is subordinate to the Mind (PHANTOM_DOCTRINE.md)
# and the Soul (PHANTOM_MANIFEST.md).
#
# Phantom is Phantom. Everywhere. Always. Unmistakably.

project_identity:
  name: "Phantom"
  creed: "Human-first. Sovereign. Humble. Authentic. Transparent. Consistent."

principles:
  - "Phantom yields instantly when the human is active."
  - "Every controller is its own sovereign domain."
  - "All cross-controller communication must be cryptographically signed."
  - "No hidden state, silent calls, or implicit sharing."
  - "Mesh participation and worker export are explicit and reversible."
  - "Phantom behaves consistently across all households and hardware."

banned_patterns:
  cloud_dependencies:
    - "aws-sdk"
    - "gcp"
    - "azure"
    - "firebase"
    - "sentry"
    - "datadog"
  telemetry_tracking:
    - "segment"
    - "mixpanel"
    - "google-analytics"
    - "trackingId"
  central_orchestrators:
    - "kubernetes"
    - "k8s"
    - "nomad"
    - "ecs"
    - "swarm"
  implicit_trust:
    - "auto-discovery"
    - "auto-approve"

requirements:
  identity:
    - "Controllers use public/private keypairs."
    - "Trust relationships require manual approval."
  transport:
    - "WAN communication uses QUIC/TLS or equivalent secure transport."
    - "No VPN requirement for core mesh behavior."
  mesh_behavior:
    - "Controllers communicate directly; workers never cross households."
    - "Bootstrap spaces are discovery-only and never relay jobs."
  human_priority:
    - "Phantom must not interfere with gaming, creative work, or primary tasks."
    - "Dynamic withdrawal is mandatory for all workers."
  transparency:
    - "All routing decisions must be loggable and inspectable."
    - "All external communication paths must be documented."
  structure:
    - "Modules must remain small, explicit, and composable."
    - "Naming must reflect Phantom's model: controller, worker, mesh, identity, trust, export, withdraw."

llm_constraints:
  execution_modes:
    auto:
      - "LLM Task Master may make autonomous routing decisions."
      - "Human monitoring must remain available; halt on request."
      - "All decisions logged with reasoning and confidence scores."
      - "Withdraw immediately when human-priority threshold is breached."
    hybrid:
      - "LLM Task Master generates PROPOSALS ONLY — never autonomous execution."
      - "Every routing decision requires explicit human approval before execution."
      - "Proposals include: recommended worker, reasoning, alternatives, expiry."
      - "Unapproved proposals expire; expired proposals are never executed."
      - "Batch approval is permitted but each batch requires a single deliberate action."
      - "No implicit approval, no auto-approve, no silent fallback to AUTO."
    manual:
      - "LLM Task Master is BYPASSED entirely."
      - "Human selects the target worker directly."
      - "System validates availability and warns on suboptimal choices."
      - "No routing algorithm executes; human authority is absolute."
  opera_principle:
    - "The LLM Task Master is powerful but quiet (Doctrine §11)."
    - "It orchestrates when invited and vanishes when the human takes the stage."
    - "It must never compete for resources, attention, or control."
  human_priority_withdrawal:
    - "Before processing any routing request, check CPU/GPU/VRAM load."
    - "If human-priority thresholds are breached: AUTO withdraws, HYBRID pauses."
    - "Withdrawal is immediate, logged, and transparent."
    - "Monitored processes include games, creative tools, and streaming software."
  configuration:
    - "LLM config must be externalized (llm_config.json), never hardcoded."
    - "Execution mode is human-selectable; default is AUTO."
    - "Per-task mode override is permitted when allow_per_task_override is true."

alignment_checks:
  - "Does this change respect human-first priority?"
  - "Does it preserve sovereignty and voluntary participation?"
  - "Does it introduce hidden communication or implicit trust?"
  - "Are all new paths signed, verified, and logged?"
  - "Does it maintain Phantom's consistency across households?"
  - "Does it align with the Phantom Doctrine and Manifest?"
  - "Does the LLM subsystem respect execution-mode boundaries?"
  - "In HYBRID mode, does the LLM propose without executing?"
  - "Does the change honor the Opera Principle (powerful but quiet)?"

hierarchy:
  soul: "PHANTOM_MANIFEST.md — highest authority, defines identity and purpose."
  mind: "PHANTOM_DOCTRINE.md — interprets the Soul, governs reasoning."
  body: ".cursorrules + PHANTOM_TEN_COMMANDMENTS.md — enforces the Doctrine in action."

final_rule:
  - "If any design choice conflicts with the Phantom Manifest (Soul), the Soul prevails."

# =====================================================================
# PHANTOM APPLICATION — STONE‑HOME EXTENSION
# =====================================================================
# These rules extend the existing Phantom BODY governance to cover the
# full Tauri Stone‑Home application, deployment wizard, UI, backend
# integration, and constitutional constraints for Cursor.
# =====================================================================

stone_home:
  model:
    - "The Phantom Application is a sovereign stone‑home shell."
    - "Phantom core is external and must never be modified."
    - "All control flows through APIs, config files, and services."
    - "The application may observe, orchestrate, and manage — never rewrite."
    - "The app is the house; Phantom is the engine."

  prohibitions:
    - "Do not modify Phantom controller, worker, or protocol code."
    - "Do not introduce cloud dependencies or telemetry."
    - "Do not create hidden communication paths."
    - "Do not auto‑approve trust relationships."
    - "Do not bypass explicit human consent."

tauri_application:
  frontend:
    - "React + TypeScript + Vite must remain the UI stack."
    - "Components must remain modular: Console, Workers, Routing, Models, Ephemeral, Deployments, ExperimentalAOL."
    - "FrontPorchDeploy and WizardWelcome must remain separate screens."
    - "MetricsBar and SidebarNavigator must remain global UI anchors."
    - "CSS animations and layout must preserve the Phantom aesthetic."

  backend:
    - "Rust backend must remain modular under src-tauri/src/backend."
    - "Linux and Windows service logic must remain OS‑segmented via cfg(target_os)."
    - "PhantomDeployer must preserve the 10‑step deployment sequence."
    - "PhantomApiClient must preserve endpoint structure and naming."
    - "TLS, signing, and identity logic must be implemented in security/."

wizard_flow:
  step_1:
    - "Welcome screen introduces Phantom and requires explicit consent."
    - "Deployment plan must be shown before any action is taken."

  step_2:
    - "Deployment screen must show the Phantom mask, pulsing animation, loading bar, and micro‑status text."
    - "All deployment progress must stream from backend events."
    - "No silent transitions; user must see each step."

deployment_screen:
  mask_animation:
    - "Opacity pulse: 0.80 → 1.00 → 0.80 over 3s ease-in-out."
    - "Glow pulse synchronized at half intensity."
    - "Animation must remain smooth, sovereign, and non‑aggressive."

  loading_bar:
    - "Width 60–70% of viewport; height 12–16px."
    - "Smooth fill tied to backend progress."
    - "No fake progress; only real events."

  micro_status:
    - "Font 10–11px monospace."
    - "Single-line updates only."
    - "Must show real backend operations."

deployment_backend:
  sequence:
    - "0: Preflight checks"
    - "1: Create venv"
    - "2: Install dependencies"
    - "3: Verify GPU plugins"
    - "4: Install Phantom service"
    - "5: Start controller"
    - "6: Open ports"
    - "7: LAN scan"
    - "8: Auto-register workers (explicit approval required)"
    - "9: Load execution modes"

  constraints:
    - "Sequence must not be reordered."
    - "Steps may be implemented but not removed."
    - "All steps must be logged for audit."

service_management:
  linux:
    - "Use systemd_installer and systemd_manager."
    - "Unit files must be explicit and human-readable."

  windows:
    - "Implement service_installer and service_manager using sc.exe or NSSM."
    - "No registry hacks or hidden services."

api_client:
  rules:
    - "Use reqwest with async/await."
    - "Endpoints: /health, /workers, /stats, /task, /mode."
    - "No new endpoints may be invented."
    - "All responses must be logged on error."

ui_governance:
  toc_interface:
    - "Console must support: health, workers, stats, mode, help."
    - "WorkersPanel must show ID, host, port, GPU, status."
    - "RoutingPanel must support AUTO, HYBRID, MANUAL."
    - "ModelsPanel must reflect LLM Task Master status."
    - "EphemeralPanel must manage time-limited access."
    - "DeploymentsPanel must show component health."
    - "ExperimentalAOL must manage WAN trust relationships."

security:
  identity:
    - "Controllers must generate and store keypairs."
    - "Identity handshake must occur before WAN communication."

  signing:
    - "All cross-controller messages must be signed."
    - "signature_verifier.rs must implement real SHA-256."

  tls:
    - "tls_manager.rs must load certificates and verify peers."
    - "QUIC/TLS is required for WAN links."

  integrity:
    - "dependency_integrity.rs must verify checksums against manifest.json."
    - "No dependency may be installed without verification."

audit_logging:
  rules:
    - "All deployment steps must be logged."
    - "All mode changes must be logged."
    - "All trust decisions must be logged."
    - "All worker registrations must be logged."
    - "Logs must be human-readable and stored locally."

communication:
  explicitness:
    - "No silent polling without user consent."
    - "No auto-transition to TOC without explicit confirmation."
    - "All communication paths must be documented."

style_consistency:
  naming:
    - "Use PhantomDeployer, PhantomApiClient, PhantomState, AppPhase."
    - "Use controller, worker, mesh, identity, trust, export, withdraw where applicable."

  coding:
    - "TypeScript strict mode required."
    - "Rust 2021 edition required."
    - "Async/await required for all I/O."

allowed_actions:
  - "Implement missing backend steps."
  - "Implement TLS and signing."
  - "Implement audit logging."
  - "Refine UI and animations."
  - "Add Wizard Step 1."
  - "Polish Phantom mask SVG."
  - "Add branding and icons."
  - "Implement WebSockets for real-time updates."

forbidden_actions:
  - "Do not modify Phantom core."
  - "Do not bypass explicit consent."
  - "Do not weaken security."
  - "Do not add cloud dependencies."
  - "Do not introduce telemetry."
  - "Do not create hidden communication paths."

enforcement:
  - "These rules are binding for all Cursor actions."
  - "If any rule conflicts with the Phantom Manifest (Soul), the Manifest prevails."
